GEMINI_API_KEY=your-key-here
# Optional: the Gemini text model. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
# Optional: the video model for the Omni presenter engine. Defaults to gemini-omni-1.1-flash.
# OMNI_MODEL=gemini-omni-1.1-flash

# Demo mode: the voiceover. Pick the provider per demo in the Studio.
# Default provider when a demo does not say (google or elevenlabs):
# TTS_PROVIDER=google

# Google Cloud Text-to-Speech (Chirp 3 HD). Either an API key with the
# Text-to-Speech API enabled, or leave it unset and use
# `gcloud auth application-default login`.
# GOOGLE_TTS_API_KEY=your-key-here
# Billing project for gcloud credentials (GOOGLE_CLOUD_PROJECT works too):
# GCP_PROJECT_ID=your-project-id
#
# Settings every demo shares are best kept in ~/.reel-studio/.env: the scripts
# copied into each demo folder read that file, but not this one.

# ElevenLabs (your cloned voice)
ELEVENLABS_API_KEY=your-key-here
ELEVENLABS_VOICE_ID=your-voice-id
# Optional: defaults to eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
